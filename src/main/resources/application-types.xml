  <types:enrichment select="#9c21491e-bf90-4956-b1b9-52c04de10dd6">
    <types:processor-declaration>
      <types:output-event>
        <types:message>
          <types:payload type="get-employees-response"/>
        </types:message>
      </types:output-event>
    </types:processor-declaration>
  </types:enrichment>
</types:mule>